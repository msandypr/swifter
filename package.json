{
  "name": "swifter",
  "version": "1.0.0",
  "private": true,
  "author": "msandypr",
  "description": "Portable Windows (.exe) to Native macOS (.app) Packaging Engine",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "version:sync": "bun scripts/sync-version.js",
    "bump": "bun scripts/sync-version.js",
    "dev": "bun run version:sync && bun --filter swifter-desktop dev",
    "build": "bun run version:sync && bun --filter swifter-desktop build",
    "check": "bun run version:sync && bun --filter swifter-ui check",
    "test": "bun run version:sync && cargo test --workspace",
    "tauri": "bun run version:sync && bun --filter swifter-desktop tauri"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
