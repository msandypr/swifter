{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swifter",
  "version": "1.0.0",
  "identifier": "com.msandypr.swifter",
  "build": {
    "beforeDevCommand": "bun run --cwd ../.. version:sync && bun run --cwd ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ../.. version:sync && bun run --cwd ../ui build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Swifter",
        "width": 940,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
